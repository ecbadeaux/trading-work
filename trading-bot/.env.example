# Settings template. Recommended: copy to ~/.config/trading-bot/.env, chmod 600, and pass
# --env-file ~/.config/trading-bot/.env (a ./.env here also works and is gitignored).
# Never commit real keys. Full reference: docs/configuration.md

# Alpaca API keys (use PAPER keys from https://app.alpaca.markets/paper/dashboard/overview)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# No endpoint/base-URL setting is needed: ALPACA_PAPER selects it.
#   true  -> https://paper-api.alpaca.markets   (use paper keys)
#   false -> https://api.alpaca.markets         (use live keys)
# Market data always uses https://data.alpaca.markets.
# Do NOT add APCA_API_BASE_URL (old alpaca-trade-api SDK); it is ignored.
#
# Paper trading is the default. Live trading requires BOTH of these:
#   ALPACA_PAPER=false
#   TRADING_BOT_ALLOW_LIVE=yes
ALPACA_PAPER=true
TRADING_BOT_ALLOW_LIVE=no

# Seconds between main-loop iterations
TRADING_BOT_LOOP_INTERVAL=60

# DEBUG, INFO, WARNING, ERROR
TRADING_BOT_LOG_LEVEL=INFO

# Directory for log files (relative to the project root)
TRADING_BOT_LOG_DIR=logs
